{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gesture Pad",
  "mainBinaryName": "gesture-pad",
  "version": "0.1.0",
  "identifier": "dev.gesturepad.live",
  "build": {
    "beforeDevCommand": {"script": "bun run dev", "cwd": "../.."},
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": {"script": "bun run build", "cwd": "../.."},
    "frontendDist": "../../dist/live"
  },
  "app": {
    "windows": [{"label": "main", "title": "Gesture Pad", "width": 1120, "height": 800, "minWidth": 640, "minHeight": 420, "backgroundColor": "#ffffff"}],
    "security": {"csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost 'self'; worker-src 'self' blob:"}
  },
  "bundle": {"active": false, "icon": ["icons/icon.png", "icons/icon.ico"]}
}
