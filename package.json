{
  "name": "gesture-pad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode live",
    "dev:annotator": "vite --mode annotator",
    "build": "tsc --noEmit && vite build --mode live",
    "build:annotator": "tsc --noEmit && vite build --mode annotator",
    "test": "bun test tests",
    "live": "bun scripts/tauri.mjs live dev",
    "annotator": "bun scripts/tauri.mjs annotator dev",
    "build:desktop": "bun scripts/tauri.mjs live build --no-bundle && bun scripts/tauri.mjs annotator build --no-bundle",
    "assets": "bun scripts/assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
